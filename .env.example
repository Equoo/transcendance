# Copy this file to .env and fill every value: cp .env.example .env

PORT=4242
SERVER_NAME=localhost

# PostgreSQL
POSTGRES_PASSWORD=

# Garage (S3 storage)
# Access key: "GK" followed by 24 hex chars: echo "GK$(openssl rand -hex 12)"
GARAGE_ACCESS_KEY=
# 64 hex chars: openssl rand -hex 32
GARAGE_SECRET_KEY=
# 64 hex chars: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Default administrator account
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 256 bits random key: openssl rand -hex 32
JWT_KEY=
